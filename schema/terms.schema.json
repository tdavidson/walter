{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemrock.com/waterline/0.1/terms.schema.json",
  "title": "Waterline terms",
  "description": "One fund's economic terms: partners, the distribution waterfall, clawback, recycling and the management fee.",
  "type": "object",
  "required": [
    "waterline",
    "fund",
    "partners",
    "waterfall"
  ],
  "additionalProperties": false,
  "properties": {
    "waterline": {
      "const": "0.1"
    },
    "fund": {
      "type": "object",
      "required": [
        "id",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minorUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "default": 2
        },
        "investmentPeriodEnd": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "partners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "commitment"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "lp",
              "gp"
            ]
          },
          "commitment": {
            "$ref": "#/$defs/amount"
          },
          "carryBearing": {
            "type": "boolean",
            "description": "Default true for an LP, false for the GP."
          },
          "feeBearing": {
            "type": "boolean",
            "description": "Default true for an LP, false for the GP."
          }
        }
      }
    },
    "waterfall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "whole-fund",
            "deal-by-deal"
          ],
          "default": "whole-fund"
        },
        "returnOfCapital": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/purpose"
              },
              "uniqueItems": true
            }
          }
        },
        "preset": {
          "enum": [
            "european-standard",
            "american-standard"
          ]
        },
        "presetTerms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "carry": {
              "$ref": "#/$defs/rate"
            },
            "pref": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/tier"
          }
        },
        "carryRecipients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "partner",
              "share"
            ],
            "additionalProperties": false,
            "properties": {
              "partner": {
                "type": "string"
              },
              "share": {
                "$ref": "#/$defs/rate"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "tiers"
          ],
          "not": {
            "required": [
              "preset"
            ]
          }
        },
        {
          "required": [
            "preset"
          ],
          "not": {
            "required": [
              "tiers"
            ]
          }
        }
      ]
    },
    "clawback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "recycling": {
      "type": "object",
      "required": [
        "cap"
      ],
      "additionalProperties": false,
      "properties": {
        "cap": {
          "$ref": "#/$defs/amount",
          "description": "A fraction of capBasis."
        },
        "capBasis": {
          "enum": [
            "commitments",
            "management-fees"
          ],
          "default": "commitments"
        },
        "until": {
          "$ref": "#/$defs/date"
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purpose"
          }
        },
        "defaultTreatment": {
          "$ref": "#/$defs/treatment"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "managementFee": {
      "type": "object",
      "required": [
        "frequency",
        "start",
        "schedule"
      ],
      "additionalProperties": false,
      "properties": {
        "frequency": {
          "enum": [
            "quarterly",
            "semiannual",
            "annual"
          ]
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "rate",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/date"
                  },
                  {
                    "type": "object",
                    "required": [
                      "event"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "event": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "rate": {
                "$ref": "#/$defs/rate"
              },
              "basis": {
                "enum": [
                  "commitments",
                  "invested",
                  "nav"
                ]
              }
            }
          }
        },
        "offsets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transaction": {
              "$ref": "#/$defs/rate"
            },
            "monitoring": {
              "$ref": "#/$defs/rate"
            },
            "directors": {
              "$ref": "#/$defs/rate"
            },
            "other": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "organizationalExpenseCap": {
          "$ref": "#/$defs/amount"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "rate": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$",
      "description": "A fraction, as a decimal string: \"0.08\" is 8%."
    },
    "source": {
      "type": "object",
      "description": "Where in the LPA the term comes from.",
      "properties": {
        "section": {
          "type": "string"
        },
        "page": {
          "type": "integer"
        },
        "quote": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "purpose": {
      "enum": [
        "investments",
        "fees",
        "expenses",
        "other"
      ]
    },
    "treatment": {
      "enum": [
        "never-distributed",
        "deemed"
      ]
    },
    "tier": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "return-of-capital"
            },
            "id": {
              "type": "string",
              "description": "Names the tier in allocations. Default: the type, then type-2, type-3 for repeats."
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "preferred-return"
            },
            "id": {
              "type": "string",
              "description": "Names the tier in allocations. Default: the type, then type-2, type-3 for repeats."
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "rate": {
              "$ref": "#/$defs/rate"
            },
            "compounding": {
              "enum": [
                "annual",
                "none"
              ],
              "default": "annual"
            },
            "base": {
              "enum": [
                "contributed",
                "unreturned"
              ],
              "default": "contributed"
            },
            "dayCount": {
              "enum": [
                "act/365",
                "30/360"
              ],
              "default": "act/365"
            },
            "multiple": {
              "$ref": "#/$defs/amount"
            }
          },
          "oneOf": [
            {
              "required": [
                "rate"
              ],
              "not": {
                "required": [
                  "multiple"
                ]
              }
            },
            {
              "required": [
                "multiple"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "rate"
                    ]
                  },
                  {
                    "required": [
                      "compounding"
                    ]
                  },
                  {
                    "required": [
                      "base"
                    ]
                  },
                  {
                    "required": [
                      "dayCount"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "catch-up"
            },
            "id": {
              "type": "string",
              "description": "Names the tier in allocations. Default: the type, then type-2, type-3 for repeats."
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "target": {
              "$ref": "#/$defs/rate"
            },
            "gpShare": {
              "$ref": "#/$defs/rate",
              "default": "1"
            },
            "measure": {
              "enum": [
                "profit",
                "preferred"
              ],
              "default": "profit"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "gpShare"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "split"
            },
            "id": {
              "type": "string",
              "description": "Names the tier in allocations. Default: the type, then type-2, type-3 for repeats."
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "gpShare": {
              "$ref": "#/$defs/rate"
            },
            "until": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lpMultiple": {
                  "$ref": "#/$defs/amount"
                },
                "lpIrr": {
                  "$ref": "#/$defs/rate"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "lpMultiple"
                  ]
                },
                {
                  "required": [
                    "lpIrr"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
