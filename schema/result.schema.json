{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemrock.com/walter/0.3/result.schema.json",
  "title": "Walter result",
  "description": "What an engine returns for a set of terms and flows.",
  "type": "object",
  "required": [
    "walter",
    "allocations"
  ],
  "properties": {
    "walter": {
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "tier",
          "partner",
          "amount"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "tier": {
            "type": "string",
            "description": "A tier id, or carry-free, recycled or clawback."
          },
          "partner": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "recontributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "partner",
          "amount"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "partner": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "recycled": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "amount",
          "treatment"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "amount": {
            "$ref": "#/$defs/money"
          },
          "treatment": {
            "enum": [
              "never-distributed",
              "deemed"
            ]
          }
        }
      }
    },
    "clawback": {
      "type": "object",
      "required": [
        "date",
        "paid",
        "entitlement",
        "amount"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "paid": {
          "$ref": "#/$defs/money"
        },
        "entitlement": {
          "$ref": "#/$defs/money"
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "cap": {
          "$ref": "#/$defs/money",
          "description": "0.3, with netOfTax: the carry paid less the assumed tax on it."
        },
        "fromEscrow": {
          "$ref": "#/$defs/money",
          "description": "0.3, with an escrow: how much of the clawback the escrow covered."
        }
      }
    },
    "accruedCarry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "nav",
          "entitlement",
          "paid",
          "accrued"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "nav": {
            "$ref": "#/$defs/money"
          },
          "entitlement": {
            "$ref": "#/$defs/money"
          },
          "paid": {
            "$ref": "#/$defs/money"
          },
          "accrued": {
            "$ref": "#/$defs/money"
          },
          "byPartner": {
            "type": "object",
            "description": "0.3. The accrued carry by partner: recipients credited (positive), the partners who bear it charged (negative). Adds up to zero.",
            "additionalProperties": {
              "$ref": "#/$defs/money"
            }
          }
        }
      }
    },
    "carry": {
      "type": "array",
      "description": "0.3. The carry in each distribution: credited to each recipient (positive) and charged to the partners who bore it (negative). The lines for a distribution add up to zero.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "partner",
          "amount"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "partner": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "escrow": {
      "type": "array",
      "description": "0.3. Carry escrow by recipient: held when carry is paid (negative), released (positive).",
      "items": {
        "type": "object",
        "required": [
          "date",
          "partner",
          "amount"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "partner": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "gross",
          "offset",
          "net"
        ],
        "properties": {
          "start": {
            "$ref": "#/$defs/date"
          },
          "end": {
            "$ref": "#/$defs/date"
          },
          "gross": {
            "$ref": "#/$defs/money"
          },
          "offset": {
            "$ref": "#/$defs/money",
            "description": "The offset applied in the period."
          },
          "net": {
            "$ref": "#/$defs/money"
          },
          "recognized": {
            "type": "object",
            "description": "0.3. The offset earned in the period, before any is applied: by kind of portfolio-company fee, and organizational for expenses over the cap.",
            "propertyNames": {
              "enum": [
                "advisory",
                "broken-deal",
                "transaction",
                "directors",
                "monitoring",
                "capital-markets",
                "arrangement",
                "origination",
                "reimbursement",
                "other",
                "organizational"
              ]
            },
            "additionalProperties": {
              "$ref": "#/$defs/money"
            }
          },
          "unapplied": {
            "$ref": "#/$defs/money",
            "description": "0.3. Offset earned but not yet applied at the period's end, carried to the next."
          },
          "byPartner": {
            "type": "object",
            "description": "0.3. The period's net fee by fee-bearing partner.",
            "additionalProperties": {
              "$ref": "#/$defs/money"
            }
          }
        }
      }
    },
    "feesByPartner": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/money"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "contributed",
          "distributed",
          "net"
        ],
        "properties": {
          "contributed": {
            "$ref": "#/$defs/money"
          },
          "distributed": {
            "$ref": "#/$defs/money"
          },
          "net": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "money": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    }
  }
}
