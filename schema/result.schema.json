{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemrock.com/walter/0.1/result.schema.json",
  "title": "Walter result",
  "description": "What an engine returns for a set of terms and flows.",
  "type": "object",
  "required": [
    "walter",
    "allocations"
  ],
  "properties": {
    "walter": {
      "const": "0.1"
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "tier",
          "partner",
          "amount"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "tier": {
            "type": "string",
            "description": "A tier id, or carry-free, recycled or clawback."
          },
          "partner": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "recontributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "partner",
          "amount"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "partner": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "recycled": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "amount",
          "treatment"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "amount": {
            "$ref": "#/$defs/money"
          },
          "treatment": {
            "enum": [
              "never-distributed",
              "deemed"
            ]
          }
        }
      }
    },
    "clawback": {
      "type": "object",
      "required": [
        "date",
        "paid",
        "entitlement",
        "amount"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "paid": {
          "$ref": "#/$defs/money"
        },
        "entitlement": {
          "$ref": "#/$defs/money"
        },
        "amount": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "accruedCarry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "nav",
          "entitlement",
          "paid",
          "accrued"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "nav": {
            "$ref": "#/$defs/money"
          },
          "entitlement": {
            "$ref": "#/$defs/money"
          },
          "paid": {
            "$ref": "#/$defs/money"
          },
          "accrued": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "gross",
          "offset",
          "net"
        ],
        "properties": {
          "start": {
            "$ref": "#/$defs/date"
          },
          "end": {
            "$ref": "#/$defs/date"
          },
          "gross": {
            "$ref": "#/$defs/money"
          },
          "offset": {
            "$ref": "#/$defs/money"
          },
          "net": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "feesByPartner": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/money"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "contributed",
          "distributed",
          "net"
        ],
        "properties": {
          "contributed": {
            "$ref": "#/$defs/money"
          },
          "distributed": {
            "$ref": "#/$defs/money"
          },
          "net": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "money": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    }
  }
}
