{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemrock.com/walter/0.2/vector.schema.json",
  "title": "Walter test vector",
  "description": "One behaviour: terms, flows, and the answer an engine must give.",
  "type": "object",
  "required": [
    "id",
    "walter",
    "title",
    "description",
    "tags",
    "provenance",
    "terms",
    "flows",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "walter": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1
    },
    "provenance": {
      "type": "string",
      "description": "hand-computed, ported: <source>, or reference-engine (reviewed but computed by the reference engine)."
    },
    "terms": {
      "$ref": "terms.schema.json"
    },
    "flows": {
      "$ref": "flows.schema.json"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "allocations": {
          "type": "array",
          "description": "Every non-zero line, summed by date, tier and partner. A line the engine produces that is not listed must be zero.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "tier",
              "partner",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "tier": {
                "type": "string"
              },
              "partner": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        "totals": {
          "type": "object",
          "description": "Total distributed to each partner, clawback included.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        },
        "clawback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "amount"
              ],
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "entitlement": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              }
            }
          ]
        },
        "accruedCarry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "entitlement"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "entitlement": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "gross",
              "offset",
              "net"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "gross": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "offset": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "net": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        "feesByPartner": {
          "type": "object",
          "description": "Each fee-bearing partner's share of the net management fee over the whole schedule.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        },
        "recontributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "partner",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "partner": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        "error": {
          "enum": [
            "invalid-terms",
            "invalid-flow",
            "unknown-partner",
            "unknown-class",
            "no-carry-recipient",
            "recycling-not-permitted",
            "recycle-over-cap",
            "recycle-after-end",
            "recycle-exceeds-proceeds"
          ]
        }
      }
    },
    "tolerance": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$",
      "default": "0.01"
    }
  }
}
